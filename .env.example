# Environment Configuration for Offline Messenger (Closed Network)
# Copy this file and rename to .env or source it before running the application

# Database Configuration (H2 - Default)
SPRING_PROFILES_ACTIVE=h2
SPRING_DATASOURCE_URL=jdbc:h2:mem:testdb

# Alternatively, use HSQLDB (uncomment to use)
# SPRING_PROFILES_ACTIVE=hsqldb
# SPRING_DATASOURCE_URL=jdbc:hsqldb:file:./data/messenger;shutdown=true

# Server Configuration
SERVER_PORT=8080

# File Upload Directory
APP_UPLOAD_DIR=./uploads

# JPA/Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_OPEN_IN_VIEW=false

# Multipart Upload Limits
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=100MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=100MB

# WebSocket Configuration
# (Default settings, modify if needed)
SPRING_WEBSOCKET_ALLOWED_ORIGINS=*

# Logging
LOGGING_LEVEL_COM_EXAMPLE_OFFLINEMESSENGER=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=INFO
LOGGING_LEVEL_ORG_HIBERNATE=WARN

# H2 Console (Development only)
SPRING_H2_CONSOLE_ENABLED=true
SPRING_H2_CONSOLE_PATH=/h2-console
